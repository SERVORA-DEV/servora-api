# ─────────────────────────────────────────────────────────────────────────
# Render production environment — Supabase Postgres + Cloudinary
#
# This file is a TEMPLATE and is committed. It must never contain real
# values. Set these in Render Dashboard -> your service -> Environment, or
# let the render.yaml blueprint prompt you for them on first import.
#
# Render does not read a .env file: config:cache runs at container start
# (docker/entrypoint.sh) and bakes whatever is in the process environment.
# After changing any value here, redeploy — a restart alone re-runs the
# entrypoint, but only a new deploy picks up dashboard edits reliably.
# ─────────────────────────────────────────────────────────────────────────

APP_NAME=Servora
APP_ENV=production
APP_DEBUG=false

# Generate a NEW one — never reuse the key that used to sit in .env.example:
#   php artisan key:generate --show
APP_KEY=

# The service's own public URL, https, no trailing slash. Signed
# email-verification links are generated against this, so a wrong value
# makes every verification link fail its signature check.
APP_URL=https://servora-api.onrender.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
BCRYPT_ROUNDS=12

# stderr, not the default stack/single: Render collects stdout/stderr into
# its log stream, while storage/logs lives on a disk that is discarded on
# every restart.
LOG_CHANNEL=stderr
LOG_LEVEL=warning

# ── Supabase Postgres ───────────────────────────────────────────────────
# Dashboard -> Connect -> "Session pooler". Three things matter:
#   * the pooler host, not db.<ref>.supabase.co — the direct host is
#     IPv6-only unless you buy the IPv4 add-on, and Render egresses on IPv4
#   * port 5432 (session mode), not 6543 (transaction mode) — transaction
#     mode has no prepared-statement support, which PDO's pgsql driver uses
#   * the dotted username postgres.<project-ref>, which the pooler requires
DB_CONNECTION=pgsql
DB_HOST=aws-0-<region>.pooler.supabase.com
DB_PORT=5432
DB_DATABASE=postgres
DB_USERNAME=postgres.<project-ref>
DB_PASSWORD=
DB_SSLMODE=require

# ── Framework stores ────────────────────────────────────────────────────
# Both DB-backed on purpose. Render's filesystem is ephemeral, and
# SubscriptionService caches a pending-business reference for a day that has
# to survive a restart. The cache/sessions/jobs tables are created by the
# standard Laravel migrations, so they already exist in Supabase.
CACHE_STORE=database
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
QUEUE_CONNECTION=sync
BROADCAST_CONNECTION=log

# ── Cloudinary ──────────────────────────────────────────────────────────
# Every uploaded image and verification document lives here; nothing is
# written to the container's disk. Format:
#   cloudinary://<api_key>:<api_secret>@<cloud_name>
# Rotate the credentials that were previously committed to .env.example
# before going live.
CLOUDINARY_URL=
UPLOAD_MAX_SIZE_KB=5120
UPLOAD_DOCUMENT_MAX_SIZE_KB=8192

# ── Xendit ──────────────────────────────────────────────────────────────
# Use the live keys here, not the xnd_development_* ones. The webhook token
# must match what's configured on the Xendit callback pointing at
# {APP_URL}/api/webhooks/xendit.
XENDIT_SECRET_KEY=
XENDIT_BASE_URL=https://api.xendit.co
XENDIT_WEBHOOK_TOKEN=

# ── Frontend ────────────────────────────────────────────────────────────
# Feeds config/cors.php's allow-list and the post-verification redirect in
# bootstrap/app.php. Scheme + host + port, no trailing slash. The LAN/
# localhost patterns in config/cors.php are http-only and can't match a
# production origin, so this is the only thing letting the deployed
# frontend through CORS.
FRONTEND_URL=https://

# ── Mail (Gmail SMTP) ───────────────────────────────────────────────────
# Same setup as local: 2-Step Verification on the sending account, then a
# 16-character App Password from https://myaccount.google.com/apppasswords
# pasted without spaces. MAIL_FROM_ADDRESS must equal MAIL_USERNAME — Gmail
# rewrites the From: header to the authenticated account otherwise. Free
# Gmail accounts are capped at 500 messages/day.
#
# WARNING: Render's free tier blocks outbound SMTP on ports 25, 465 and 587,
# so this configuration cannot deliver from a free web service. It needs a
# paid instance, or an HTTP-API provider (Resend, Mailgun, Postmark) whose
# traffic isn't blocked. See DEPLOYMENT.md.
MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_SCHEME=smtp
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="Servora"
MAIL_TIMEOUT=10

# ── Unused in production, listed so nothing falls back unexpectedly ─────
FILESYSTEM_DISK=local
APP_MAINTENANCE_DRIVER=file

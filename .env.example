APP_NAME=Servora
APP_ENV=local
# php artisan key:generate
APP_KEY=
APP_DEBUG=true
# Must be this machine's current LAN IPv4 (Wi-Fi adapter) + the port
# `php artisan serve` runs on, NOT localhost/127.0.0.1 — Flutter/other
# devices on the network resolve image_url and API calls through this.
# Re-run `ipconfig` and update this whenever the IP changes (new network,
# DHCP lease renewal, hotspot vs Wi-Fi, etc).
# When testing the web app with `pnpm dev:https` (needed for camera access
# on a LAN IP), uploaded images only load on the https page if this is
# https://<LAN-IP>:3000 (served via Nuxt's /storage proxy) — note that
# breaks image URLs for Flutter, so switch back afterwards.
APP_URL=http://0.0.0.0:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# PostgreSQL everywhere — Supabase in production, a local Postgres in
# development. Several migrations emit Postgres-specific DDL (see
# App\Support\PostgresSchema), so MySQL/SQLite are no longer supported.
#
# To point at Supabase, use the SESSION pooler from Dashboard -> Connect:
#   DB_HOST=aws-0-<region>.pooler.supabase.com
#   DB_PORT=5432
#   DB_DATABASE=postgres
#   DB_USERNAME=postgres.<project-ref>    <- dotted form, required by the pooler
#   DB_SSLMODE=require
# Not the direct db.<ref>.supabase.co host (IPv6-only without the paid IPv4
# add-on, and Render's egress is IPv4), and not port 6543 (transaction mode
# doesn't support the prepared statements PDO issues by default).
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=servora
DB_USERNAME=postgres
DB_PASSWORD=
DB_SSLMODE=prefer

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

# Max upload size (KB) for ImageUploadService — config/uploads.php
UPLOAD_MAX_SIZE_KB=5120

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Real delivery over Gmail SMTP. Requirements on the sending account:
#   1. 2-Step Verification must be ON, or App Passwords won't be offered.
#   2. Generate a 16-character App Password at
#      https://myaccount.google.com/apppasswords and paste it WITHOUT the
#      spaces Google displays it with.
#   3. MAIL_FROM_ADDRESS must equal MAIL_USERNAME. Gmail silently rewrites
#      the From: header to the authenticated account unless the address is a
#      verified "Send mail as" alias, so anything else is discarded.
# Free Gmail accounts are capped at 500 messages/day.
MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_SCHEME=smtp
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="Servora"
# Kept under the mobile client's 12s request timeout so a stalled SMTP
# connection surfaces as a handled error instead of a client-side timeout.
MAIL_TIMEOUT=10


AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"


XENDIT_SECRET_KEY=
XENDIT_BASE_URL=https://api.xendit.co
XENDIT_WEBHOOK_TOKEN=

# cloudinary://<api_key>:<api_secret>@<cloud_name> — Cloudinary Dashboard
CLOUDINARY_URL=









#importtans
FRONTEND_URL=https://xb9nvs85-3000.asse.devtunnels.ms
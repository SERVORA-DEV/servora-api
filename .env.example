APP_NAME=Servora
# Local template. Production (render.yaml) sets APP_ENV=production, APP_DEBUG=false.
APP_ENV=local
APP_KEY=
# ^ run `php artisan key:generate`. Never commit real secrets to this file —
# it is tracked by git. Put real values only in .env (ignored).
APP_DEBUG=true
# Must be this machine's current LAN IPv4 (Wi-Fi adapter) + the port
# `php artisan serve` runs on, NOT localhost/127.0.0.1 — Flutter/other
# devices on the network resolve image_url and API calls through this.
# Re-run `ipconfig` and update this whenever the IP changes (new network,
# DHCP lease renewal, hotspot vs Wi-Fi, etc).
APP_URL=http://0.0.0.0:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Postgres everywhere now — see .env.example for the Supabase session-pooler
# settings. Previous MySQL values are kept in .env.mysql.backup.
DB_CONNECTION=pgsql
DB_HOST=your-db-host
DB_PORT=5432
DB_DATABASE=postgres
DB_USERNAME=your-db-user
DB_PASSWORD=your-db-password
DB_PERSISTENT=true
DB_SSLMODE=require

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

# Max upload size (KB) for ImageUploadService — config/uploads.php
UPLOAD_MAX_SIZE_KB=5120

CACHE_STORE=file
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Real delivery over Gmail SMTP. Requirements on the sending account:
#   1. 2-Step Verification must be ON, or App Passwords won't be offered.
#   2. Generate a 16-character App Password at
#      https://myaccount.google.com/apppasswords and paste it WITHOUT the
#      spaces Google displays it with.
#   3. MAIL_FROM_ADDRESS must equal MAIL_USERNAME. Gmail silently rewrites
#      the From: header to the authenticated account unless the address is a
#      verified "Send mail as" alias, so anything else is discarded.
# Free Gmail accounts are capped at 500 messages/day.
MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_SCHEME=smtp
MAIL_USERNAME=you@gmail.com
MAIL_PASSWORD=your-gmail-app-password
MAIL_FROM_ADDRESS=you@gmail.com
MAIL_FROM_NAME="Servora"
# Kept under the mobile client's 12s request timeout so a stalled SMTP
# connection surfaces as a handled error instead of a client-side timeout.
MAIL_TIMEOUT=10


AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"


XENDIT_SECRET_KEY=xnd_development_your_key
XENDIT_BASE_URL=https://api.xendit.co
XENDIT_WEBHOOK_TOKEN=your-xendit-webhook-token

CLOUDINARY_URL=cloudinary://api_key:api_secret@cloud_name









#importtans
FRONTEND_URL=http://localhost:3000
# Extra browser origins allowed by CORS, comma-separated (only needed in production for
# staging/custom domains; localhost/LAN origins are allowed automatically when APP_ENV is not production).
CORS_ALLOWED_ORIGINS=

# "Continue with Google" on the web app owner sign-in (see config/services.php).
# The OAuth client ID from Google Cloud Console (type: Web application). Must match
# GOOGLE_CLIENT_ID in servora-web. Leave empty to turn Google sign-in off.
GOOGLE_CLIENT_ID=

# Who runs Servora — shown in the Terms of Service and Privacy Policy (config/legal.php).
# Fill these in before launch; until then the documents show [placeholders].
LEGAL_OPERATOR_NAME=
LEGAL_OPERATOR_ADDRESS=
LEGAL_CONTACT_EMAIL=

# Free trial an owner can start once from the Plans page (config/trial.php).
TRIAL_ENABLED=true
TRIAL_DAYS=14
TRIAL_PLAN_CATEGORY=Trial
